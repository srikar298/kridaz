generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                        @id @default(uuid())
  email                   String                        @unique
  username                String                        @unique
  password                String
  role                    Role                          @default(USER)
  name                    String
  phone                   String?                       @unique
  profilePicture          String?
  city                    String?
  state                   String?
  latitude                Decimal?                      @db.Decimal(10, 8)
  longitude               Decimal?                      @db.Decimal(11, 8)
  isVerified              Boolean                       @default(false)
  isOnboarded             Boolean                       @default(false)
  gender                  String?
  dob                     DateTime?
  bio                     String?
  interests               String[]
  sportTypes              String[]
  googleId                String?
  appleId                 String?                       @unique
  lastSeen                DateTime                      @default(now())
  status                  String                        @default("active")
  migrationStatus         Json?
  socialAccounts          Json?
  notificationPreferences Json?
  walletBalance           Decimal                       @default(0) @db.Decimal(12, 2)
  reservedBalance         Decimal                       @default(0) @db.Decimal(12, 2)
  bookingCount            Int                           @default(0)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @default(now()) @updatedAt
  bannerPicture           String?
  locationSharingEnabled  Boolean                       @default(true)
  tokenVersion            Int                           @default(0)
  isEmailVerified         Boolean                       @default(false)
  battingStyle            String?
  bowlingStyle            String?
  auditLogs               AuditLog[]
  blogs                   Blog[]
  bookings                Booking[]
  createdChats            Chat[]                        @relation("ChatCreatorUser")
  chatMemberships         ChatParticipant[]             @relation("UserChatMemberships")
  comments                Comment[]
  resolvedDisputes        Dispute[]                     @relation("DisputeAdmin")
  disputes                Dispute[]                     @relation("DisputeRaiser")
  gameDisputes            GameDispute[]
  gameSlots               GameSlot[]
  hostedGames             HostedGame[]                  @relation("HostRelation")
  scoredGames             HostedGame[]                  @relation("ScorerRelation")
  streamedGames           HostedGame[]                  @relation("StreamerRelation")
  officiatedGames         HostedGame[]                  @relation("UmpireRelation")
  sentMessages            Message[]                     @relation("MessageSenderUser")
  notifications           Notification[]
  otp                     OTP?
  onDemandBookings        OnDemandProfessionalBooking[]
  ownerProfile            OwnerProfile?
  ownerRequests           OwnerRequest[]
  platformConfigs         PlatformConfig[]
  careerStats             PlayerCareerStats[]
  posts                   Post[]
  postReports             PostReport[]
  professionalBookings    ProfessionalBooking[]
  professionalCustomers   ProfessionalCustomer[]
  matchRequests           ProfessionalMatchRequest[]
  recoveryToken           RecoveryToken?
  sentInquiries           ProfessionalInquiry[]         @relation("InquirySender")
  receivedInquiries       ProfessionalInquiry[]         @relation("InquiryReceiver")
  reels                   Reel[]
  reelComments            ReelComment[]
  reelInteractions        ReelInteraction[]
  reelReports             ReelReport[]
  refreshTokens           RefreshToken[]
  reviews                 Review[]
  stories                 Story[]
  supportTickets          SupportTicket[]
  systemSettings          SystemSetting[]
  ownedTeams              Team[]                        @relation("TeamOwner")
  teamMemberships         TeamMember[]
  turfInteractions        TurfInteraction[]
  turfLikes               TurfLike[]
  earnedBadges            UserBadge[]
  devices                 UserDevice[]
  oauth                   UserOAuth?
  profile                 UserProfile?
  followers               UserRelationship[]            @relation("Following")
  following               UserRelationship[]            @relation("Follower")
  stats                   UserStats?
  VenueInvite             VenueInvite[]
  wallet                  Wallet?
  walletTransactions      WalletTransaction[]
  likedPosts              Post[]                        @relation("PostLikes")
  studentSessions         ProfessionalSession[]         @relation("SessionStudents")
  viewedStories           Story[]                       @relation("StoryViewers")

  ownedTournaments    Tournament[]         @relation("TournamentOwner")
  tournamentOfficials TournamentOfficial[]
  gameApplications    GameApplication[]

  @@index([role])
  @@index([latitude, longitude])
}

model UserProfile {
  id         String    @id @default(uuid())
  userId     String    @unique
  bio        String?
  gender     String?
  dob        DateTime?
  interests  String[]  @default([])
  sportTypes String[]  @default([])
  city       String?
  state      String?
  latitude   Decimal?  @db.Decimal(10, 8)
  longitude  Decimal?  @db.Decimal(11, 8)
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserOAuth {
  id             String   @id @default(uuid())
  userId         String   @unique
  socialAccounts Json?    @default("{}")
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique
  userId    String?  @unique
  emailOtp  String?
  phoneOtp  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model RecoveryToken {
  id        String    @id @default(uuid())
  userId    String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnerRequest {
  id              String   @id @default(uuid())
  userId          String?
  name            String
  email           String   @unique
  phone           String
  status          String   @default("pending")
  role            String   @default("venue_owner")
  businessDetails Json?
  documents       Json?
  portfolioUrl    String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OwnerProfile {
  id                      String                        @id @default(uuid())
  userId                  String                        @unique
  businessName            String
  verified                Boolean                       @default(false)
  walletBalance           Decimal                       @default(0) @db.Decimal(12, 2)
  reservedBalance         Decimal                       @default(0) @db.Decimal(12, 2)
  pendingBalance          Decimal                       @default(0) @db.Decimal(12, 2)
  inProgressBalance       Decimal                       @default(0) @db.Decimal(12, 2)
  disputeBalance          Decimal                       @default(0) @db.Decimal(12, 2)
  withdrawnBalance        Decimal                       @default(0) @db.Decimal(12, 2)
  promotionalBalance      Decimal                       @default(0) @db.Decimal(12, 2)
  price                   Float                         @default(0)
  dob                     DateTime?
  gender                  String?
  bio                     String?
  coachingLevel           String?
  isOnline                Boolean                       @default(false)
  latitude                Decimal?                      @db.Decimal(10, 8)
  longitude               Decimal?                      @db.Decimal(11, 8)
  lastLocationUpdate      DateTime?
  trainingTypes           String[]
  ageGroups               String[]
  languages               String?
  achievements            String?
  experience              String?
  specialization          String?
  certifications          String[]
  bannerUrl               String?
  instagram               String?
  linkedin                String?
  youtube                 String?
  streamPlatforms         String[]
  matchesCovered          String?
  camerasSupported        Int?
  streamQuality           String?
  liveScoringSupport      Boolean?                      @default(false)
  matchFormats            String[]
  liveCommentarySupported Boolean?                      @default(false)
  panelDiscussionEnabled  Boolean?                      @default(false)
  structuredAchievements  Json?
  portfolio               Json?
  rating                  Float                         @default(0)
  numReviews              Int                           @default(0)
  businessDetails         Json?
  bankingDetails          Json?
  verificationDocs        Json?
  notificationPrefs       Json?
  governmentId            String?                       @unique
  maxTravelRadius         Int                           @default(50)
  avgDailyActivePct       Float                         @default(0.0)
  acceptanceRate30d       Float                         @default(100.0)
  trustScore              Float                         @default(100.0)
  cityRank                Int?
  stateRank               Int?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  bookingNotifications    BookingNotification[]
  createdChats            Chat[]                        @relation("ChatCreatorOwner")
  chatMemberships         ChatParticipant[]             @relation("OwnerChatMemberships")
  coupons                 Coupon[]
  disputes                Dispute[]
  sentMessages            Message[]                     @relation("MessageSenderOwner")
  notifications           Notification[]
  lockedBookings          OnDemandProfessionalBooking[] @relation("LockedBookings")
  onDemandBookings        OnDemandProfessionalBooking[]
  user                    User                          @relation(fields: [userId], references: [id])
  profBookings            ProfessionalBooking[]
  customers               ProfessionalCustomer[]
  matchOffers             ProfessionalMatchOffer[]
  onlineSessions          ProfessionalOnlineSession[]
  sessions                ProfessionalSession[]
  tasks                   ProfessionalTask[]
  reviews                 Review[]                      @relation("ProfessionalReview")
  trustScoreEvents        TrustScoreEvent[]
  turfs                   Turf[]
  umpireSessions          UmpireSession[]
  withdrawalRequests      WithdrawalRequest[]
}

model WithdrawalRequest {
  id              String       @id @default(uuid())
  ownerId         String
  amount          Decimal      @db.Decimal(12, 2)
  status          String       @default("PENDING")
  bankDetails     Json
  transactionId   String?
  rejectionReason String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  owner           OwnerProfile @relation(fields: [ownerId], references: [id])

  @@index([ownerId, createdAt])
}

model Turf {
  id                  String                        @id @default(uuid())
  ownerId             String
  name                String
  description         String?
  location            String
  city                String
  state               String
  latitude            Decimal?                      @db.Decimal(10, 8)
  longitude           Decimal?                      @db.Decimal(11, 8)
  image               String
  images              String[]
  sportTypes          String[]
  groundTypes         String[]
  facilities          String[]
  youtubeUrl          String?
  pricePerHour        Decimal                       @db.Decimal(10, 2)
  openTime            String
  closeTime           String
  isActive            Boolean                       @default(true)
  status              String                        @default("pending")
  slotDuration        Int                           @default(60)
  breakTime           Int                           @default(0)
  availableDays       String[]
  offDays             String[]
  slotsConfigDuration String                        @default("Until Changed")
  slotsConfigWeeks    Int?
  slotsConfigExpiry   DateTime?
  slotsNeedsUpdate    Boolean                       @default(false)
  slug                String?                       @unique
  mapUrl              String?
  policies            String?                       @default("")
  managerContacts     Json?
  generatedSlots      Json?
  verificationData    Json?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @default(now()) @updatedAt
  pendingUpdates      Json?
  bookings            Booking[]
  coupons             Coupon[]
  hostedGames         HostedGame[]
  onDemandBookings    OnDemandProfessionalBooking[]
  matchRequests       ProfessionalMatchRequest[]
  reviews             Review[]
  timeSlots           TimeSlot[]
  owner               OwnerProfile                  @relation(fields: [ownerId], references: [id])
  turfInteractions    TurfInteraction[]
  turfLikes           TurfLike[]
  VenueInvite         VenueInvite?

  tournamentVenues TournamentVenue[]

  @@index([ownerId])
  @@index([city, state, status, isActive])
  @@index([slug])
}

model TimeSlot {
  id        String   @id @default(uuid())
  turfId    String
  startTime DateTime
  endTime   DateTime
  price     Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking?
  turf      Turf     @relation(fields: [turfId], references: [id])

  @@index([turfId, startTime, endTime])
}

model Booking {
  id                  String              @id @default(uuid())
  userId              String
  turfId              String
  timeSlotId          String?             @unique
  totalPrice          Decimal             @db.Decimal(10, 2)
  paidAmount          Decimal             @db.Decimal(10, 2)
  balanceAmount       Decimal             @db.Decimal(10, 2)
  advanceAmount       Decimal             @default(0) @db.Decimal(10, 2)
  platformFee         Decimal             @default(0) @db.Decimal(10, 2)
  gstAmount           Decimal             @default(0) @db.Decimal(10, 2)
  ownerRevenue        Decimal             @default(0) @db.Decimal(10, 2)
  status              BookingStatus       @default(PENDING)
  revenueStatus       RevenueStatus       @default(PENDING)
  bookingSource       String              @default("USER")
  paymentMethod       String?
  paymentType         String              @default("FULL")
  qrCode              String?
  isManuallyCompleted Boolean             @default(false)
  orderId             String?
  paymentId           String?
  paymentSignature    String?
  paymentStatus       String?             @default("PENDING")
  playStartTime       DateTime?
  playEndTime         DateTime?
  reviewWindowEndsAt  DateTime?
  settledAt           DateTime?
  guestName           String?
  guestPhone          String?
  guestEmail          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  timeSlot            TimeSlot?           @relation(fields: [timeSlotId], references: [id])
  turf                Turf                @relation(fields: [turfId], references: [id])
  user                User                @relation(fields: [userId], references: [id])
  disputes            Dispute[]
  walletTransactions  WalletTransaction[]

  @@index([userId, status])
  @@index([status, playStartTime])
  @@index([turfId, status, playStartTime])
  @@index([orderId])
}

model Wallet {
  id              String              @id @default(uuid())
  userId          String              @unique
  balance         Decimal             @default(0) @db.Decimal(12, 2)
  reservedBalance Decimal             @default(0) @db.Decimal(12, 2)
  promotionalBalance Decimal          @default(0) @db.Decimal(12, 2)
  user            User                @relation(fields: [userId], references: [id])
  transactions    WalletTransaction[]
}

model WalletTransaction {
  id                String   @id @default(uuid())
  userId            String
  amount            Decimal  @db.Decimal(12, 2)
  type              String
  status            String   @default("PENDING")
  description       String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  bookingId         String?
  disputeId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  walletId          String?
  couponId          String?
  payableAmount     Decimal? @db.Decimal(12, 2)
  booking           Booking? @relation(fields: [bookingId], references: [id])
  coupon            Coupon?  @relation(fields: [couponId], references: [id])
  user              User     @relation(fields: [userId], references: [id])
  wallet            Wallet?  @relation(fields: [walletId], references: [id])

  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([userId, createdAt])
  @@index([razorpayOrderId])
  @@index([couponId])
}

model Review {
  id              String                       @id @default(uuid())
  userId          String
  turfId          String?
  professionalId  String?
  rating          Int
  comment         String
  reply           String?
  replyDate       DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  bookingId       String?
  onDemandBooking OnDemandProfessionalBooking? @relation(fields: [bookingId], references: [id])
  professional    OwnerProfile?                @relation("ProfessionalReview", fields: [professionalId], references: [id])
  turf            Turf?                        @relation(fields: [turfId], references: [id])
  user            User                         @relation(fields: [userId], references: [id])

  @@unique([userId, bookingId])
}

model HostedGame {
  id                    String               @id @default(uuid())
  hostId                String
  gameType              String
  gameMode              String               @default("PROFESSIONAL")
  date                  DateTime
  time                  String
  endTime               String?
  turfId                String?
  umpireId              String?
  scorerId              String?
  streamerId            String?
  umpireRequest         Json?
  scorerRequest         Json?
  streamerRequest       Json?
  streamConfig          Json?
  perPlayerCharge       Decimal              @default(0) @db.Decimal(10, 2)
  perSeatCharge         Decimal              @default(0) @db.Decimal(10, 2)
  groundCost            Decimal              @default(0) @db.Decimal(10, 2)
  umpireCost            Decimal              @default(0) @db.Decimal(10, 2)
  streamerCost          Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount        Decimal              @default(0) @db.Decimal(10, 2)
  platformFee           Decimal              @default(0) @db.Decimal(10, 2)
  totalCost             Decimal              @default(0) @db.Decimal(10, 2)
  couponId              String?
  status                String               @default("ACTIVE")
  shortId               String?              @unique
  scoringStatus         String               @default("NOT_STARTED")
  city                  String?
  state                 String?
  customVenue           String?
  isLive                Boolean              @default(false)
  streamStatus          String               @default("offline")
  overlayConfig         Json?
  deletedAt             DateTime?
  liveStartedAt         DateTime?
  overlayToken          String?
  lastCommentary        String?
  lastCommentaryAt      DateTime?
  liveScoreSnapshot     Json?
  oversPerInnings       Int                  @default(20)
  tickerTheme           String               @default("neon_classic")
  customUmpire          Json?
  customScorer          Json?
  customStreamer        Json?
  customProfessionals   Json?
  isAiCommentaryEnabled Boolean              @default(false)
  commentaryVoice       String               @default("en_US-lessac-medium")
  commentaryLanguage    String               @default("en")
  commentaryStyle       String               @default("professional")
  name                  String?
  format                String?
  ballType              String?
  groundType            String?
  scoringPassword       String?
  youtubeLiveUrl        String?
  maxMembers            Int                  @default(11)
  customDays            Int                  @default(1)
  customOversPerDay     Int                  @default(20)
  escrowAmount          Decimal              @default(0) @db.Decimal(10, 2)
  disputeRaised         Boolean              @default(false)
  payoutStatus          String               @default("PENDING")
  scoringMatchId        String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  coinTransferStatus    String               @default("PENDING")
  votedStartedBy        String[]             @default([])
  scheduledStartAt      DateTime?
  slowOverRateConfig    Json?
  bookingId             String?
  matchPreferences      Json?
  requestType           String               @default("MATCH")
  broadcasts            Broadcast[]
  cricketMatch          CricketMatch?
  invites               CustomPlayerInvite[]
  gameDisputes          GameDispute[]
  slots                 GameSlot[]
  teams                 GameTeam[]
  coupon                Coupon?              @relation(fields: [couponId], references: [id])
  host                  User                 @relation("HostRelation", fields: [hostId], references: [id])
  scorer                User?                @relation("ScorerRelation", fields: [scorerId], references: [id])
  streamer              User?                @relation("StreamerRelation", fields: [streamerId], references: [id])
  turf                  Turf?                @relation(fields: [turfId], references: [id])
  umpire                User?                @relation("UmpireRelation", fields: [umpireId], references: [id])
  tournamentId          String?
  tournament            Tournament?          @relation(fields: [tournamentId], references: [id])
  tournamentStage       String? // GROUP, QUARTER_FINAL, SEMI_FINAL, FINAL
  tournamentPoolId      String? // Links back to TournamentPool if it's a group match
  gameApplications      GameApplication[]
}

model GameTeam {
  id           String     @id @default(uuid())
  gameId       String
  name         String
  image        String?
  teamKey      String
  createdAt    DateTime   @default(now())
  linkedTeamId String?
  slots        GameSlot[]
  game         HostedGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  linkedTeam   Team?      @relation(fields: [linkedTeamId], references: [id])
}

model GameDispute {
  id         String     @id @default(uuid())
  gameId     String
  raisedById String
  reason     String?
  status     String     @default("OPEN")
  adminNote  String?
  resolvedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  game       HostedGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  raisedBy   User       @relation(fields: [raisedById], references: [id])
}

model GameSlot {
  id             String              @id @default(uuid())
  gameId         String
  teamId         String?
  userId         String?
  customPlayerId String?             @unique
  role           String?
  status         String              @default("OPEN")
  paymentStatus  String              @default("NONE")
  addedById      String?
  createdAt      DateTime            @default(now())
  customPlayer   CustomPlayerInvite? @relation("SlotInvite", fields: [customPlayerId], references: [id])
  game           HostedGame          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team           GameTeam?           @relation(fields: [teamId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])
}

model CustomPlayerInvite {
  id             String     @id @default(uuid())
  gameId         String
  name           String
  email          String
  phone          String?
  userId         String?
  role           String     @default("PLAYER")
  isProfessional Boolean    @default(false)
  inviteToken    String?    @unique
  inviteStatus   String     @default("PENDING")
  mustPay        Boolean    @default(false)
  invitedAt      DateTime   @default(now())
  createdAt      DateTime   @default(now())
  game           HostedGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  slot           GameSlot?  @relation("SlotInvite")
}

model CricketMatch {
  id                   String            @id @default(uuid())
  gameId               String            @unique
  status               String            @default("NOT_STARTED")
  timerState           String            @default("NOT_STARTED")
  timerLastStartedAt   DateTime?
  totalDurationSeconds Int               @default(0)
  result               String?
  tossWinner           String?
  tossDecision         String?
  currentInningsIndex  Int               @default(0)
  oversPerInnings      Int               @default(20)
  strikerId            String?
  nonStrikerId         String?
  bowlerId             String?
  revisedTarget        Int?
  revisedOvers         Float?
  matchOfficials       Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  freeHitActive        Boolean           @default(false)
  houseRules           Json?
  slowOverRateConfig   Json?
  game                 HostedGame        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  innings              Innings[]
  timeline             MatchBall[]
  playerStats          MatchPlayerStat[]
}

model Innings {
  id                  String       @id @default(uuid())
  matchId             String
  inningsIndex        Int
  battingTeam         String
  totalRuns           Int          @default(0)
  totalWickets        Int          @default(0)
  totalBalls          Int          @default(0)
  isCompleted         Boolean      @default(false)
  extras              Json
  battingTeamReviews  Int          @default(2)
  fieldingTeamReviews Int          @default(2)
  powerplayOvers      Int          @default(0)
  createdAt           DateTime     @default(now())
  match               CricketMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MatchBall {
  id               String       @id @default(uuid())
  matchId          String
  inningsIndex     Int
  over             Int
  ballInOver       Int
  batterId         String
  bowlerId         String
  fielderId        String?
  runs             Int          @default(0)
  isExtra          Boolean      @default(false)
  extraType        String       @default("NONE")
  extraRuns        Int          @default(0)
  isBoundary       Boolean      @default(false)
  isFour           Boolean      @default(false)
  isSix            Boolean      @default(false)
  isWicket         Boolean      @default(false)
  wicketType       String?
  playerOutId      String?
  wicketTakerId    String?
  fieldingPosition String?
  distance         String?
  commentary       String?
  timestamp        DateTime     @default(now())
  match            CricketMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MatchPlayerStat {
  id                 String       @id @default(uuid())
  matchId            String
  userId             String
  inningsIndex       Int
  battingRuns        Int          @default(0)
  battingBalls       Int          @default(0)
  battingFours       Int          @default(0)
  battingSixes       Int          @default(0)
  outStatus          String       @default("NOT_OUT")
  dismissedById      String?
  caughtById         String?
  bowlingOvers       Float        @default(0)
  bowlingBalls       Int          @default(0)
  bowlingMaidens     Int          @default(0)
  bowlingRuns        Int          @default(0)
  bowlingWickets     Int          @default(0)
  bowlingWides       Int          @default(0)
  bowlingNoBalls     Int          @default(0)
  isSubstitute       Boolean      @default(false)
  substituteForId    String?
  timeSpentSeconds   Int          @default(0)
  timerLastStartedAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  match              CricketMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId, inningsIndex])
}

model Broadcast {
  id          String     @id @default(uuid())
  gameId      String
  platform    String
  accountId   String?
  accountName String?
  broadcastId String?
  streamId    String?
  videoId     String?
  streamKey   String?
  rtmpUrl     String?
  watchUrl    String?
  status      String     @default("offline")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  game        HostedGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Team {
