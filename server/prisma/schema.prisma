  sessionEnd           DateTime?
  consecutiveSkipCount Int          @default(0)
  professional         OwnerProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId, sessionEnd])
}

model PlatformConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  user        User?    @relation(fields: [updatedBy], references: [id])
}

model UserDevice {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  platform   String
  createdAt  DateTime  @default(now())
  appVersion String?
  deviceId   String?
  lastSeenAt DateTime?
  locale     String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SentryAlert {
  id           String   @id @default(uuid())
  sentryUrl    String
  errorMessage String
  level        String
  isResolved   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model VenueInvite {
  id        String   @id
  adminId   String
  email     String?
  phone     String?
  token     String   @unique
  turfId    String   @unique
  status    String   @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [adminId], references: [id])
  Turf      Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
}

enum OnDemandBookingStatus {
  PENDING
  NOTIFYING
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  PENDING_COMPLETION
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED_BY_USER
  CANCELLED_BY_PRO
  NO_SHOW_PENDING
  NO_SHOW
  CANCELLED
  FAILED
}

enum MatchRequestStatus {
  SEARCHING
  MATCHED
  EXPIRED
  CANCELLED
  EXHAUSTED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum Role {
  USER
  VENUE_OWNER
  OWNER
  ADMIN
  UMPIRE
  LIMITED_UMPIRE
  COACH
  SCORER
  STREAMER
  SYSTEM
  ANONYMOUS
  COMMENTATOR
  CHEERLEADER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PLAYING
  IN_REVIEW_WINDOW
  COMPLETED
  DISPUTED
  CANCELLED
}

enum RevenueStatus {
  PENDING
  IN_PROGRESS
  SETTLED
  FROZEN
  REFUNDED
}

model Tournament {
  id              String               @id @default(uuid())
  name            String
  sport           String
  format          String
  entryFee        Decimal              @default(0) @db.Decimal(10, 2)
  advanceFee      Decimal              @default(0) @db.Decimal(10, 2)
  prizePool       Decimal              @default(0) @db.Decimal(10, 2)
  numberOfWinners Int                  @default(1)
  posterUrl       String?
  logoUrl         String?
  organizerName   String?
  organizerNumber String?
  organizerEmail  String?
  startDate       DateTime?
  endDate         DateTime?
  category        String? // Open, Corporate, Community, etc.
  ballType        String?
  pitchType       String?
  matchType       String?
  maxTeams        Int?
  status          String               @default("DRAFT") // DRAFT, PUBLISHED, COMPLETED
  currentStep     Int                  @default(1)
  details         Json? // Store unstructured details for draft
  ownerId         String
  owner           User                 @relation("TournamentOwner", fields: [ownerId], references: [id])
  pools           TournamentPool[]
  teams           TournamentTeam[]
  officials       TournamentOfficial[]
  sponsors        TournamentSponsor[]
  venues          TournamentVenue[]
  matches         HostedGame[]
  transactions    WalletTransaction[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model TournamentPool {
  id           String           @id @default(uuid())
  tournamentId String
  name         String
  maxTeams     Int
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams        TournamentTeam[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model TournamentTeam {
  id            String          @id @default(uuid())
  tournamentId  String
  teamId        String
  poolId        String?
  paymentStatus String          @default("PENDING") // PENDING, PARTIAL, FULL
  amountPaid    Decimal         @default(0) @db.Decimal(10, 2)
  tournament    Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pool          TournamentPool? @relation(fields: [poolId], references: [id])
  team          Team            @relation(fields: [teamId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model TournamentOfficial {
  id            String     @id @default(uuid())
  tournamentId  String
  userId        String? // If registered KRIDAZ user
  name          String
  role          String
  phone         String?
  paymentAmount Decimal    @default(0) @db.Decimal(10, 2)
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user          User?      @relation(fields: [userId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model TournamentSponsor {
  id           String     @id @default(uuid())
  tournamentId String
  name         String
  logoUrl      String?
  bannerUrl    String?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model TournamentVenue {
  id           String     @id @default(uuid())
  tournamentId String
  turfId       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  turf         Turf       @relation(fields: [turfId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ProfessionalInquiry {
  id          String   @id @default(uuid())
  userId      String
  proId       String
  interestFor String
  phone       String
  message     String   @db.Text
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation("InquirySender", fields: [userId], references: [id])
  pro  User @relation("InquiryReceiver", fields: [proId], references: [id])
}

model GameApplication {
  id            String   @id @default(uuid())
  gameId        String
  teamId        String
  captainId     String
  status        String   @default("PENDING")
  totalRequired     Float    @default(0)
  guarantorReleased Float    @default(0)
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  game    HostedGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team    Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  captain User       @relation(fields: [captainId], references: [id])
}
